{
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist/",
    "jsx": "react",
    "allowJs": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es5",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "paths": {
      "Svg/*": ["./src/assets/svg/*"],
      "Components/*": ["./src/components/*"]
    }
  },
  "exclude": ["**/*.stories.*", "**/*.test.*"],
  "include": ["./tools/**/*", "./src/**/*", "./webpack.config.ts"]
}
