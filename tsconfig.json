{
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist",
    "jsx": "react",
    "allowJs": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es5",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true
  },
  "include": ["./tools/**/*", "./src/**/*", "src/index.ts", "./build/webpack.config.ts"],
  "exclude": ["node_modules", "**/*.stories.*", "**/*.test.*", "./dist"]
}
